# Backend environment variables (loaded by infrastructure/settings.py).
#
# For local development: copy to `fastapi_backend/.env` and fill in real values
# (`.env` is gitignored — never commit real secrets), or run `bash scripts/dev-setup.sh`
# to generate non-secret dev defaults when the file is missing.
#
# For Cursor cloud agents: set these in the Cloud Agents "Secrets" tab
# (cursor.com/dashboard?tab=cloud-agents). They are injected as environment
# variables. They are NOT read from this file and do NOT belong in
# .cursor/environment.json.
#
# Values below are placeholders/examples only.

# --- Required: core security & database ---------------------------------------
# Historical migrations are PostgreSQL-only, so DATABASE_URL must be a Postgres URL.
# On Render, DATABASE_URL should come from a linked Postgres, not a hand-pasted value.
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
HASH_KEY=change-me-to-a-long-random-secret

# --- Optional: service/agent access to admin ops ------------------------------
# Comma-separated bearer tokens that let a machine caller (an agent/ops tool)
# invoke admin operations (e.g. POST /notifications/broadcast) as a *service
# principal*: stateless (many agents concurrently), audited by token fingerprint,
# revocable per-token, and a SEPARATE secret from HASH_KEY. Unset = no service
# access (human admin auth unaffected). Generate each with `openssl rand -hex 32`.
# SERVICE_TOKENS=token-one,token-two

# --- Required: email / domain identity ----------------------------------------
APP_DOMAIN=example.com
# SENDER_NAME optional — prefers the instance manifest brand name
# (next-pwa/product/instance.config.ts → instance.json), else derived from
# APP_DOMAIN. Set only to override (env > manifest > domain-derivation).
# SENDER_NAME=Example
# NOTE: APP_DOMAIN is cross-checked against the instance manifest domain and
# FAILS CLOSED on a production mismatch (dev/local *.local hosts are exempt).

# --- Token / password / code policy (have code defaults; override as needed) ---
# HASH_ALGORITHM=HS256
# TOKEN_TTL=30
# REFRESH_TOKEN_TTL=43200
# MIN_PASSWORD_LENGTH=8
# MAX_PASSWORD_LENGTH=128
# PASSWORD_STRENGTH_THRESHOLD=3
# VERIFICATION_CODE_TTL=15
# RESET_PASSWORD_CODE_TTL=15

# --- Runtime flags (have defaults; override as needed) ------------------------
# development → non-Secure cookies (http://localhost); production → Secure cookies (HTTPS).
# COOKIE_SAMESITE defaults to lax; set only when you need strict or none.
ENV=development

# --- Email delivery (provider-specific; optional) -----------------------------
EMAIL_PROVIDER=BREVO
# BREVO_API_KEY=
# SENDGRID_API_KEY=
# CONTACT_EMAIL_LOCAL_PART optional — defaults from the instance manifest
# (instance.config.ts contact.localPart), else "hello". Set only to override.
# CONTACT_EMAIL_LOCAL_PART=hello
# SUPPORTED_CURRENCIES optional (comma-separated) — defaults from the instance
# manifest currency.supported, else "GBP". DEFAULT_CURRENCY (catalog default) is
# derived from the manifest / this list, not a separate env var.
# SUPPORTED_CURRENCIES=GBP

# --- OAuth providers (optional) -----------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# --- AI providers (optional) --------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# Media lanes (P7, D43) — each dormant without its key:
# FAL_API_KEY=
# ELEVENLABS_API_KEY=

# --- Observability (optional; see .cursor/rules/backend-observability.mdc)
# Unset = error tracking disabled (dev default). Set to the Sentry project DSN
# to capture unhandled exceptions and ERROR-level logs in production.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Caching (optional; see .cursor/rules/backend-caching.mdc) --------
# Unset = bounded in-process memory cache (default; correct on the gateway).
# Set to a Redis/Valkey URL (Render Key Value) for shared cross-worker caching
# and exact rate limits.
# CACHE_URL=redis://host:6379/0
# CACHE_DEFAULT_TTL=60
# CACHE_MAX_MEMORY_ENTRIES=1024
# --- Stripe payments (optional — payment features disabled when unset) --------
# Secret key from the Stripe dashboard; webhook secret is printed by
# `python scripts/stripe_bootstrap.py --api-origin https://<backend-host>`:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Entitlement reconciliation sweep interval (seconds) — the failsafe behind
# webhooks. Optional; defaults to 21600 (6h). Set 0 to disable:
# ENTITLEMENT_RECONCILE_INTERVAL_SECONDS=21600
# Per-session Checkout branding (colors/font/shape/name from the generated
# manifest; logo resolved at runtime from the bootstrap upload, no config
# needed). Defaults to on; set false to use the account dashboard branding.
# STRIPE_CHECKOUT_BRANDING=true

# --- Admin inbox (optional — dormant until the mailbox pair is set) -----------
# INBOX_IMAP_* are this instance's mailbox credentials from provisioning (see
# domain-ops references/provision-inbox.md); they power the whole inbox:
# read AND send (Forward Email full stack).
# INBOX_IMAP_EMAIL=
# INBOX_IMAP_PASSWORD=
# Full-loop mailbox canary cadence override (code default 12h; 0 disables):
# INBOX_CANARY_INTERVAL_HOURS=

# --- Object storage (optional — local disk under STORAGE_LOCAL_DIR by default) -
# Preferred production path: CLOUDFLARE_API_TOKEN (Account → Workers R2 Storage →
# Edit). Endpoint, `<APP_DOMAIN-slug>-public/private` buckets, and S3 credentials
# (token id + sha256(token)) are derived at runtime — no AWS_* hand-set vars.
# CLOUDFLARE_R2_API_TOKEN is accepted as an alias for CLOUDFLARE_API_TOKEN
# (settings.py reads either); set only one.
# CLOUDFLARE_API_TOKEN=
# Optional disambiguation when the token reaches multiple accounts:
# CLOUDFLARE_ACCOUNT_ID=
# Explicit STORAGE_S3_* still wins for non-R2 S3 providers (then AWS_* or the
# Cloudflare token supplies credentials). STORAGE_S3_PRIVATE_BUCKET is required
# for CV upload once STORAGE_S3_BUCKET is set. Locally the private plane is
# derived (uploads -> uploads-private, never mounted).
# STORAGE_S3_BUCKET=
# STORAGE_S3_PRIVATE_BUCKET=
# STORAGE_S3_ENDPOINT_URL=
# STORAGE_S3_REGION=
# STORAGE_S3_PUBLIC_BASE_URL=

# --- Extra frontend origins for CORS (comma-separated, optional) --------------
# EXTRA_FRONTEND_ORIGINS=
# ALLOWED_ORIGIN_SUFFIX=

# Optional paper-brokerage integration (instance-owned, dormant unless all three
# are set; the built-in simulated broker is the default and needs nothing):
# PRODUCT_ALPACA_API_KEY=
# PRODUCT_ALPACA_SECRET_KEY=
# PRODUCT_ALPACA_BASE_URL=

# Optional EIA API v2 key (instance-owned; register at eia.gov/opendata). Dormant
# without it: with it, ERCOT and PJM hourly demand and day-ahead demand forecast
# (Form EIA-930, US public domain) go live and backfill two years of history.
# EIA_API_KEY=
